          "reorderEnabled": true,
          "title": "",
          "activeItemIndex": 0,
          "content": [
            {
              "type": "component",
              "componentName": "codeEditor",
              "title": "* cascade_test.json",
              "componentState": {
                "code": [
                  "const SwitchCount = 5;",
                  "const ExtrusionFudge = 0.1;",
                  "",
                  "const AcrylicThickness = 3.25;",
                  "const BoardThickness = (3 / 16) * 25.4;",
                  "const MinWallThickness = 2;",
                  "",
                  "const Params_Card = {",
                  "    Width: 54,",
                  "    Height: 81,",
                  "    Thickness: AcrylicThickness",
                  "};",
                  "",
                  "const Params_Frame = {",
                  "    XSideWidth: 12,",
                  "    YSideWidth: 13,",
                  "    MagOffset: 4,",
                  "    CardOverlap: 2,",
                  "    FrameWidth: 0,",
                  "    FrameHeight: 0,",
                  "    CutoutFillet: 2",
                  "};",
                  "",
                  "Params_Frame.FrameWidth = Params_Card.Width + (Params_Frame.XSideWidth - Params_Frame.CardOverlap) * 2;",
                  "Params_Frame.FrameHeight = Params_Card.Height + (Params_Frame.YSideWidth - Params_Frame.CardOverlap) * 2;",
                  "",
                  "const Params_Wiring = {",
                  "    BendAllowance: 2,",
                  "    ConnAllowance: 4,",
                  "    WireDiam: 1,",
                  "    ThruHoleRadius: 1,",
                  "    ResistorRadius: 1.25,",
                  "    ResistorLength: 7",
                  "};",
                  "",
                  "const Params_ReedSwitch = {",
                  "    BodyLength: 15,",
                  "    BodySide: 3.25 + ExtrusionFudge * 2,",
                  "    LegLength: 14,",
                  "    CutoutLength: 0",
                  "};",
                  "",
                  "Params_ReedSwitch.CutoutLength = Params_ReedSwitch.BodyLength + Params_Wiring.BendAllowance * 2;",
                  "",
                  "const Params_BackPlate = {",
                  "    Thickness: MinWallThickness + Params_ReedSwitch.BodySide",
                  "};",
                  "",
                  "const Params_SupportMag = {",
                  "    Radius: 4 + ExtrusionFudge,",
                  "    Thickness: 3,",
                  "    CollarThickness: Params_Frame.MagOffset / 2,",
                  "    CollarRadius: 0",
                  "};",
                  "",
                  "Params_SupportMag.CollarRadius = Params_SupportMag.Radius + Params_SupportMag.CollarThickness;",
                  "",
                  "const Params_LEDStrip = {",
                  "    Width: 12.5,",
                  "    Height: 1.7,",
                  "    LEDWidth: 5.2,",
                  "    LEDHeight: 2.1,",
                  "};",
                  "",
                  "const EDGE_Z_BACK_LEFT = 0;",
                  "const EDGE_Z_FRONT_LEFT = 2;",
                  "const EDGE_Z_FRONT_RIGHT = 4;",
                  "const EDGE_Z_BACK_RIGHT = 6;",
                  "",
                  "const EDGES_Z_ALL = [EDGE_Z_BACK_LEFT, EDGE_Z_FRONT_LEFT, EDGE_Z_FRONT_RIGHT, EDGE_Z_BACK_RIGHT,];",
                  "",
                  "function led_strip(strip_length) {",
                  "    // Translate([0, 0, Params_LEDStrip.Height / 2],",
                  "    //     Union([",
                  "    //         Translate([0, 0, Params_LEDStrip.LEDHeight / 2],",
                  "    //             Box(strip_length, Params_LEDStrip.LEDWidth, Params_LEDStrip.LEDHeight, true)),",
                  "    //         Translate([0, 0, -Params_LEDStrip.Height / 2],",
                  "    //             Box(strip_length, Params_LEDStrip.Width, Params_LEDStrip.Height, true))",
                  "    //     ])",
                  "    // );",
                  "}",
                  "",
                  "",
                  "function mag_collar() {",
                  "    return Difference(",
                  "        Cylinder(Params_SupportMag.CollarRadius, BoardThickness, true),",
                  "        [",
                  "            Translate([0, 0, BoardThickness / 2 - Params_SupportMag.Thickness / 2],",
                  "                Cylinder(Params_SupportMag.Radius, Params_SupportMag.Thickness, true)),",
                  "        ]",
                  "    );",
                  "}",
                  "",
                  "function switch_cutout() {",
                  "    return Union([",
                  "        Box(",
                  "            Params_ReedSwitch.BodySide,",
                  "            Params_ReedSwitch.CutoutLength,",
                  "            Params_ReedSwitch.BodySide,",
                  "            true),",
                  "        Translate([0, Params_ReedSwitch.CutoutLength / 2, 0],",
                  "            Cylinder(Params_Wiring.ThruHoleRadius, Params_BackPlate.Thickness * 10, true)",
                  "        ),",
                  "        Translate([0, -Params_ReedSwitch.CutoutLength / 2, 0],",
                  "            Cylinder(Params_Wiring.ThruHoleRadius, Params_BackPlate.Thickness * 10, true)",
                  "        ),",
                  "    ]);",
                  "}",
                  "",
                  "function back_frame() {",
                  "    const spread_height = Params_Frame.FrameHeight - Params_SupportMag.CollarRadius * 2;",
                  "    const spread_width = Params_Frame.FrameWidth - Params_SupportMag.CollarRadius * 2",
                  "",
                  "    // const frameBase = FilletEdges(",
                  "    //         Box(Params_Frame.FrameWidth, Params_Frame.FrameHeight, Params_BackPlate.Thickness, true),",
                  "    //         Params_SupportMag.CollarRadius, EDGES_Z_ALL",
                  "    //     );",
                  "",
                  "    let unionList = [",
                  "        Box(Params_Frame.FrameWidth, Params_Frame.FrameHeight, Params_BackPlate.Thickness, true)",
                  "    ];",
                  "",
                  "    for (let x = 0; x < 2; x++) {",
                  "        for (let y = 0; y < 2; y++) {",
                  "            unionList.push(",
                  "                Translate([",
                  "                    -spread_width / 2 + spread_width * x,",
                  "                    -spread_height / 2 + spread_height * y,",
                  "                    Params_BackPlate.Thickness / 2 + BoardThickness / 2],",
                  "                    mag_collar()",
                  "                )",
                  "            );",
                  "        }",
                  "    }",
                  "",
                  "    let differenceList = [];",
                  "",
                  "    for (let switchIndex = 0; switchIndex < SwitchCount; switchIndex++) {",
                  "        let spreadHorzOffset = spread_width * (switchIndex % 2);",
                  "        let switchHorzOffset = Params_ReedSwitch.CutoutLength * ((switchIndex + 1) % 2);",
                  "",
                  "        differenceList.push(",
                  "            Translate([",
                  "                -spread_width / 2 + spreadHorzOffset + switchHorzOffset / 2,",
                  "                -spread_height / 2 + (spread_height / (SwitchCount + 1)) * (switchIndex + 1),",
                  "                Params_BackPlate.Thickness / 2 - Params_ReedSwitch.BodySide / 2",
                  "            ], switch_cutout())",
                  "        );",
                  "    }",
                  "",
                  "    let returnPlate = Difference(Union(unionList), differenceList);",
                  "",
                  "    // return returnPlate;",
                  "",
                  "    // For some reason, if I fillet the edges of the box before unioning the peices ",
                  "    // together then the Union call throws an error.  Apply the box filet here.",
                  "    return FilletEdges(returnPlate, Params_SupportMag.CollarRadius, [56, 59, 68, 72]);",
                  "}",
                  "",
                  "Translate([0, 0, Params_BackPlate.Thickness * 2], back_frame());",
                  "",
                  "",
                  "// led_strip(card_width);",
                  "// mag_switch();",
                  ""
                ]
              },
              "width": 50,
              "isClosable": false,
              "reorderEnabled": true
            }
          ]
