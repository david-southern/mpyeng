@using PiController;

@model pi_engine_room.Models.WarpCoreViewModel

@{
    ViewData["Title"] = "Engine Room Controller";
}

<form method="post">
    <div class="text-left">
        <h4>Engine Room Controller</h4>
        <div>Current Warp Core Power Level: @($"{Model.PowerLevel:N3}")</div>
        <div>Set Power Level to:</div>
        <input asp-for="PowerLevel" />
        <button asp-action="PowerLevel">Update</button>

        @{
            if (Model.AnimationEffects.Count > 0)
            {
                <h5>Animation Effects</h5>

                bool hasUpdate = false;

                foreach (IAnimationEffect effect in Model.AnimationEffects)
                {
                    <h6>@(effect.Name)</h6>
                    <div class=".small">@(effect.Description)</div>

                    if (effect.Parameters.Count > 0)
                    {
                        <div class="font-weight-bold">@(effect.Name) Parameters</div>
                        foreach (AnimationParameter param in effect.Parameters)
                        {
                            <div>@(param.Name)</div>
                            <div class=".small">@(param.Description)</div>
                            <input asp-for="@param.Value" />
                            hasUpdate = true;
                        }
                    }
                }

                if (hasUpdate)
                {
                    <button asp-action="UpdateParams">Update</button>
                }
            }
        }

        <h4>Strip Test</h4>
        <div>Set Strip Color to:</div>
        <select asp-for="CurrentColor" asp-items="WarpCoreViewModel.AvailableColors"></select>
        <button asp-action="StripColor">Update</button>
    </div>
</form>
