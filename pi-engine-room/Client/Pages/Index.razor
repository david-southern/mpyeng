@page "/"

@implements IAsyncDisposable
@inject HttpClient Http
@inject Microsoft.JSInterop.IJSRuntime JS

<MudPaper>

</MudPaper>

<MudText Typo="Typo.h6" GutterBottom="true">Core Power Load</MudText>

@if (coreConfig == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <MudPaper Class="d-flex">
        <MudPaper Class="flex-grow-0">
            @*    <img src="data:image/png;base64, iVBORw0KGgoAAAANSUhEUgAAAAUAAAAFCAYAAACNbyblAAAAHElEQVQI12P4//8/w38GIAXDIBKE0DHxgljNBAAO9TXL0Y4OHwAAAABJRU5ErkJggg==" alt="Red dot" />
            *@
            <img id="coreImage" style="width: 80px; height: 854px" />
        </MudPaper>

        <MudPaper Class="flex-grow-1 mx-3">
            <MudText Typo="Typo.h6">Power Level</MudText>
            <MudButtonGroup OverrideStyles="false" Class="mx-1">
                <MudButton Color="Color.Primary" OnClick="@(() => SetPowerLevel(0.0))"
                       Variant="@(PowerLevelVariant(0.0))">0</MudButton>
                <MudButton Color="Color.Primary" OnClick="@(() => SetPowerLevel(0.1))"
                       Variant="@(PowerLevelVariant(0.1))">1</MudButton>
                <MudButton Color="Color.Primary" OnClick="@(() => SetPowerLevel(0.2))"
                       Variant="@(PowerLevelVariant(0.2))">2</MudButton>
                <MudButton Color="Color.Primary" OnClick="@(() => SetPowerLevel(0.3))"
                       Variant="@(PowerLevelVariant(0.3))">3</MudButton>
                <MudButton Color="Color.Primary" OnClick="@(() => SetPowerLevel(0.4))"
                       Variant="@(PowerLevelVariant(0.4))">4</MudButton>
                <MudButton Color="Color.Primary" OnClick="@(() => SetPowerLevel(0.5))"
                       Variant="@(PowerLevelVariant(0.5))">5</MudButton>
                <MudButton Color="Color.Primary" OnClick="@(() => SetPowerLevel(0.6))"
                       Variant="@(PowerLevelVariant(0.6))">6</MudButton>
                <MudButton Color="Color.Warning" OnClick="@(() => SetPowerLevel(0.7))"
                       Variant="@(PowerLevelVariant(0.7))">7</MudButton>
                <MudButton Color="Color.Warning" OnClick="@(() => SetPowerLevel(0.8))"
                       Variant="@(PowerLevelVariant(0.8))">8</MudButton>
                <MudButton Color="Color.Warning" OnClick="@(() => SetPowerLevel(0.9))"
                       Variant="@(PowerLevelVariant(0.9))">9</MudButton>
                <MudButton Color="Color.Error" OnClick="@(() => SetPowerLevel(1.0))"
                       Variant="@(PowerLevelVariant(1.0))">10</MudButton>
            </MudButtonGroup>

            @*            <MudButtonGroup OverrideStyles="false">
                <MudButton Color="Color.Warning" OnClick="@(() => SetPowerLevel(2.0))" Variant="@(PowerLevelVariant(2.0))">Warning</MudButton>
                <MudButton Color="Color.Error" OnClick="@(() => SetPowerLevel(3.0))" Variant="@(PowerLevelVariant(3.0))">Danger!</MudButton>
                <MudButton Color="Color.Default" OnClick="@(() => SetPowerLevel(4.0))" Variant="@(PowerLevelVariant(4.0))">DEED!</MudButton>
                </MudButtonGroup>
            *@
            <MudText Typo="Typo.h6">Sim Config</MudText>
            <MudGrid Spacing="2">
                <MudItem>
                    <MudButton Variant="Variant.Filled" OnClick="StartAnimation">Start Core Animation</MudButton>
                </MudItem>
                <MudItem>
                    <MudButton Variant="Variant.Filled" OnClick="StopAnimation">Stop Core Animation</MudButton>
                </MudItem>
            </MudGrid>
            <MudGrid Spacing="2">
                <MudItem>
                    <MudNumericField @bind-Value="@coreConfig.FrameRate" OnBlur="@(() => SimChange())" 
                        Label="Animation Frame Rate" Variant="Variant.Filled" HideSpinButtons="true" />
                </MudItem>
                <MudItem>
                    <MudNumericField @bind-Value="@coreConfig.TimeScale" OnBlur="@(() => SimChange())" 
                        Label="Time Scale" Variant="Variant.Filled" HideSpinButtons="true" />
                </MudItem>
                <MudItem>
                    <MudNumericField @bind-Value="@coreConfig.BrightnessScale" OnBlur="@(() => SimChange())"
                        Label="Brightness Scale" Variant="Variant.Filled" HideSpinButtons="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudPaper>
}

@code {
    private CoreConfigurationViewModel coreConfig = null!;
    private bool IsAnimating = false;

    protected override async Task OnInitializedAsync()
    {
        coreConfig = await Http.GetFromJsonAsync<CoreConfigurationViewModel>("/config")
            ?? throw new InvalidOperationException("Unable to get core config from server");
    }

    private IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (module is not null)
        {
            await module.DisposeAsync();
        }
    }

    private async Task SetPowerLevel(double powerLevel)
    {
        coreConfig.PowerLevel = powerLevel;
        using var result = await Http.PostAsJsonAsync("/config", coreConfig);
        coreConfig = await result.Content.ReadFromJsonAsync<CoreConfigurationViewModel>()
            ?? throw new InvalidOperationException("Unable to get core config from server");
        StateHasChanged();
    }

    private async Task SimChange()
    {
        using var result = await Http.PostAsJsonAsync("/config", coreConfig);
        coreConfig = await result.Content.ReadFromJsonAsync<CoreConfigurationViewModel>()
            ?? throw new InvalidOperationException("Unable to get core config from server");

        if (IsAnimating)
        {
            await StopAnimation();
            await StartAnimation();
        }
    }

    private Variant PowerLevelVariant(double buttonPowerLevel)
    {
        return (coreConfig.PowerLevel ?? 0).DoubleEQ(buttonPowerLevel) ? Variant.Filled : Variant.Outlined;
    }

    private async Task StartAnimation()
    {
        if (module != null)
        {
            await module.InvokeAsync<string>("startAnimation", coreConfig.FrameRate);
            IsAnimating = true;
        }
    }

    private async Task StopAnimation()
    {
        if (module != null)
        {
            await module.InvokeAsync<string>("stopAnimation");
            IsAnimating = false;
        }
    }
}
