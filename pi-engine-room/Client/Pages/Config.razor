@page "/config"

@using pi_engine_room.Shared
@inject HttpClient Http

<MudText Typo="Typo.h6" GutterBottom="true">Pi Engine Room Configuration</MudText>
<MudText Class="mb-8">Not implemented just yet...</MudText>

@if (coreConfig == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <MudTable Items="coreConfig.CorePalettes" Hover="true" SortLabel="Sort By" Elevation="0">
        <HeaderContent>
            <MudTh><MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<CorePalette, object>(x=>x.CoreColor)">Color</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<CorePalette, object>(x=>x.PowerLevel)">Power Level</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Color">@context.CoreColor</MudTd>
            <MudTd DataLabel="PowerLevel">@context.PowerLevel</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{50, 100}" />
        </PagerContent>
    </MudTable>
}

@code {
    private CoreConfiguration? coreConfig = null;

    protected override async Task OnInitializedAsync()
    {
        coreConfig = await Http.GetFromJsonAsync<CoreConfiguration>("/config");
    }
}
