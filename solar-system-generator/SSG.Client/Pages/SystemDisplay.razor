@page "/"

@using Services
@using SSG.Helpers;

@namespace SSG.Client.Pages

@inject IJSRuntime JS
@inject IDialogService DialogService

<PageTitle>Solar System Generator v0.3</PageTitle>

<MudPopover Open="@(FileMenuOpen)" AnchorOrigin="@(Origin.TopRight)" TransformOrigin="@(Origin.TopRight)"
    Class="px-4 pt-4">
    <div class="d-flex flex-column">
        <MudText>Current System: @($"{(SolarSystem?.Name ?? "<none>")}")</MudText>
        <MudPaper Elevation="2" Class="pa-2 pt-0">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" @onclick="NewSystem">New</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" @onclick="ShowLoadDialog">Load
            </MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                Disabled="@(string.IsNullOrEmpty(SolarSystem?.Name))" @onclick="SaveSystem">Save</MudButton>
        </MudPaper>
        <MudButton OnClick="@ToggleFileMenu" Class="ml-auto mr-n3 mb-1" Color="Color.Error">Close</MudButton>
    </div>
</MudPopover>

<MudPopover Open="@(SettingsMenuOpen)" AnchorOrigin="@(Origin.TopRight)" TransformOrigin="@(Origin.TopRight)"
    Class="px-4 pt-4">
    <MudText>Settings</MudText>
    <MudStack>
        <MudText Typo="Typo.caption">Speed:</MudText>
        <div>
            <MudSlider @bind-Value="AnimationSpeed" T="float" Min="-1" Step="0.01f" Max="1" Color="Color.Info">
            </MudSlider>
            <MudText Typo="Typo.caption">@(AnimationSpeed) (@(Settings.AnimationTimeScaleHuman))</MudText>
        </div>
        <MudStack Row="true">
            <MudText Typo="Typo.caption">Zoom:</MudText>
            <MudIconButton Icon="@Icons.Material.Outlined.ViewInAr" Variant="Variant.Filled" Color="Color.Primary"
                Size="Size.Small" Style="height: fit-content" Title="Reset Zoom" OnClick="@(() => ResetZoom())" />
        </MudStack>
        <div>
            <MudSlider @bind-Value="Zoom" T="float" Min="0.1f" Step="0.1f" Max="100f" Color="Color.Info">
            </MudSlider>
            <MudText Typo="Typo.caption">@($"{Zoom}") x</MudText>
        </div>
        <MudStack Row="true">
            <MudText Typo="Typo.caption">View Angle:</MudText>
            <MudIconButton Icon="@Icons.Material.Outlined.Autorenew" Variant="Variant.Filled" Color="Color.Primary"
                Size="Size.Small" Style="height: fit-content" Title="Reset View" OnClick="@(() => ResetView())" />
        </MudStack>
        <div>
            <MudSlider @bind-Value="ViewAngle" T="float" Min="0.1f" Step="0.1f" Max="90f" Color="Color.Info">
            </MudSlider>
            <MudText Typo="Typo.caption">@($"{ViewAngle}") degrees</MudText>
        </div>
        <MudStack Row="true">
            <div>
                <MudTextField @bind-Value="StarScale" Label="Star Scale" Variant="Variant.Outlined"
                    Margin="Margin.Dense">
                </MudTextField>
            </div>
            <div>
                <MudTextField @bind-Value="PlanetScale" Label="Planet Scale" Variant="Variant.Outlined"
                    Margin="Margin.Dense">
                </MudTextField>
            </div>
        </MudStack>
        <MudText Typo="Typo.caption">Grid Type:</MudText>
        <MudRadioGroup @bind-SelectedOption="GridType">
            <MudRadio Option="@(SSGSettings.GRID_TYPE_NONE)" Color="Color.Primary" Size="Size.Small">
                @(SSGSettings.GRID_TYPE_NONE)</MudRadio>
            <MudRadio Option="@(SSGSettings.GRID_TYPE_POLAR)" Color="Color.Primary" Size="Size.Small">
                @(SSGSettings.GRID_TYPE_POLAR)</MudRadio>
            <MudRadio Option="@(SSGSettings.GRID_TYPE_RECTANGULAR)" Color="Color.Primary" Size="Size.Small">
                @(SSGSettings.GRID_TYPE_RECTANGULAR)</MudRadio>
        </MudRadioGroup>
        <MudSelect @bind-Value="BackgroundImage" Label="Background">
            @foreach (BackgroundImageData imageData in BackgroundImageData.BackgroundImages)
            {
                <MudSelectItem Value="@(imageData)">@(imageData.Description)</MudSelectItem>
            }
        </MudSelect>
        <MudStack Row="true">
            <MudSlider @bind-Value="Settings.BackgroundImage.Contrast" T="float" Min="0f" Step="1f" Max="100f"
                Color="Color.Info">
                Desaturate: @(Settings.BackgroundImage.Contrast)
            </MudSlider>
            @* <MudSlider @bind-Value="Settings.BackgroundImage.Brightness" T="float" Min="0f" Step="1f" Max="100f"
                Color="Color.Info">
                Brighten: @(Settings.BackgroundImage.Brightness)
                </MudSlider> *@
            <MudSlider @bind-Value="Settings.BackgroundImage.Blur" T="float" Min="0f" Step="1f" Max="100f"
                Color="Color.Info">
                Blur: @(Settings.BackgroundImage.Blur)
            </MudSlider>
        </MudStack>
        <MudStack Row="true">
            <MudSlider @bind-Value="Settings.BackgroundImage.Darken" T="float" Min="0f" Step="1f" Max="100f"
                Color="Color.Info">
                Darken: @(Settings.BackgroundImage.Darken)
            </MudSlider>
            <MudSlider @bind-Value="Settings.BackgroundImage.Lighten" T="float" Min="0f" Step="1f" Max="100f"
                Color="Color.Info">
                Lighten: @(Settings.BackgroundImage.Lighten)
            </MudSlider>
        </MudStack>
        <MudButton Variant="Variant.Filled" OnClick="UpdateSettings">Update Background Settings</MudButton>

    </MudStack>
    <MudButton OnClick="@ToggleSettingsMenu" Class="ml-auto mr-n3 mb-1" Color="Color.Error">Close</MudButton>
</MudPopover>

<MudGrid>
    <MudItem xs="9">
        <MudPaper Elevation="2" Class="pa-2">
            <div id="ssgCanvas" style="width: 100%; height: calc(100vh - 90px);">
                <div id="systemTime" class="system-time"></div>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="3">
        <MudStack Spacing="1">
            @* <MudButton Color="Color.Primary" Variant="Variant.Filled" @onclick="UpdateSystem">Update</MudButton> *@
            <MudText>Solar System: @($"{(SolarSystem?.Name ?? "<none>")}")</MudText>
            <MudTreeView Items="SolarSystemTree" Dense="true" Hover="true" Color="Color.Tertiary"
                ExpandOnDoubleClick="true" @bind-SelectedValue="SelectedObject">
                <ItemTemplate>
                    <MudTreeViewItem @bind-Expanded="@context.IsExpanded" Items="@context.ChildObjects"
                        Value="@context">
                        <Content>
                            <MudStack Row="true" Style="width: 100%">
                                <MudTreeViewItemToggleButton @bind-Expanded="@context.IsExpanded"
                                    Visible="@context.HasChild" />
                                <MudIcon Icon="@(ObjectIcon(context))" Class="ml-0 mr-2" Color="@Color.Default" />
                                <MudIconButton Icon="@Icons.Material.Filled.RemoveRedEye" Variant="Variant.Filled"
                                    Color="@(Settings.LookAt == context.Name ? Color.Secondary : Color.Primary)"
                                    Size="Size.Small" Style="height: fit-content" Title="Look At"
                                    OnClick="@(() => LookAt(context))" />
                                <MudText>@context.Name</MudText>
                                <div class="flex-grow-1"></div>
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Variant="Variant.Filled"
                                    Color="Color.Primary" Size="Size.Small" Style="height: fit-content"
                                    Title="Add Child" OnClick="@(() => AddChild(context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Remove" Variant="Variant.Filled"
                                    Color="Color.Warning" Size="Size.Small" Style="height: fit-content" Title="Remove"
                                    OnClick="@(() => RemoveElement(context))" />
                            </MudStack>
                        </Content>
                    </MudTreeViewItem>
                </ItemTemplate>

                @* <ItemTemplate>
                    <MudTreeViewItem Items="@context.ChildObjects" Value="@context" Icon="@(ObjectIcon(context))"
                    Text="@context.Name">
                    </MudTreeViewItem>
                    </ItemTemplate> *@
            </MudTreeView>

            <MudStack Spacing="1">
                <MudStack Row="true">
                    <MudTextField Disabled="@(SelectedObject == null)" @bind-Value="EditName" Label="Name"
                        Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                    <MudCheckBox Disabled="@(SelectedObject == null)" @bind-Checked="@EditIsStar" Label="Is Star?">
                    </MudCheckBox>
                </MudStack>
                <MudStack Row="true">
                    <MudTextField Disabled="@(SelectedObject == null)" @bind-Value="EditOrbitalSemiMajorAxis"
                        Label="SemiMajor Axis" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                    <MudTextField Disabled="@(SelectedObject == null)" @bind-Value="EditOrbitalSemiMinorAxis"
                        Label="SemiMinor Axis" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                    <MudTextField Disabled="@(SelectedObject == null)" @bind-Value="EditOrbitalPerigee"
                        Label="Perigee" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                </MudStack>
                <MudStack Row="true">
                    <MudTextField Disabled="@(SelectedObject == null)" @bind-Value="EditOrbitalVelocity"
                        Label="Orbital Period" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                    <MudTextField Disabled="@(SelectedObject == null)" @bind-Value="EditPhaseAngle" Label="Orbit Phase"
                        Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                </MudStack>
                <MudStack Row="true">
                    <MudTextField Disabled="@(SelectedObject == null)" @bind-Value="EditOrbitalInclination"
                        Label="Orbital Inclination" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                    <MudTextField Disabled="@(SelectedObject == null)" @bind-Value="EditOrbitalColor"
                        Label="Orbit Color" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                </MudStack>
                <MudStack Row="true">
                    <MudTextField Disabled="@(SelectedObject == null)" @bind-Value="EditObjectRadius" Label="Radius"
                        Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                    <MudTextField Disabled="@(SelectedObject == null)" @bind-Value="EditObjectColor" Label="Color"
                        Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                </MudStack>
                <MudStack Row="true">
                    <MudTextField Disabled="@(SelectedObject == null)" @bind-Value="EditRingInnerRadius"
                        Label="Ring Inner Radius" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                    <MudTextField Disabled="@(SelectedObject == null)" @bind-Value="EditRingWidth" Label="Ring Width"
                        Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                </MudStack>
                <MudStack Row="true">
                    <MudTextField Disabled="@(SelectedObject == null)" @bind-Value="EditRingColor" Label="Ring Color"
                        Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                    <MudTextField Disabled="@(SelectedObject == null)" @bind-Value="EditRingDensity"
                        Label="Ring Density" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
                </MudStack>
            </MudStack>
        </MudStack>
    </MudItem>
</MudGrid>

<MudDialog @bind-IsVisible="LoadDialogVisible" Options="LoadDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Download" Class="ml-3" />Load a System
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="3">
                Premade:
            </MudItem>
            <MudItem xs="9">
                <MudButton Color="Color.Primary" Variant="Variant.Filled"
                    @onclick="@(() => LoadPremade(MockSolarSystemData.Sol))">Sol</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled"
                    @onclick="@(() => LoadPremade(MockSolarSystemData.CetiAlpha))">Ceti Alpha</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled"
                    @onclick="@(() => LoadPremade(MockSolarSystemData.Wack))">Wack</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled"
                    @onclick="@(() => LoadPremade(MockSolarSystemData.SpeedTest))">SpeedTest</MudButton>
            </MudItem>
            <MudItem xs="3">
                Load:
            </MudItem>
            <MudItem xs="9">
                <InputFile OnChange="@LoadSystem" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    @* <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(LoadDialogSelection == null)"
        OnClick="@(LoadSystem)" Class="px-10">Load</MudButton>
        </DialogActions> *@
</MudDialog>