{
    "indent_size": 4,
    "indent_char": " ",
    "brace_style": "expand",
    "break_chained_methods": true,
    "indent_empty_lines": false,
    "keep_array_indentation": false,
    "keep_function_indentation": false,
    "operator_position": "after-newline",
    "space_before_conditional": true,
    "space_in_paren": true
}